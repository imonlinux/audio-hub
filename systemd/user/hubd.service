[Unit]
Description=Audio Hub Controller Daemon
After=pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire.service wireplumber.service pipewire-pulse.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=AUDIOHUB_CONFIG=/etc/audiohub/unit.env
ExecStart=/usr/local/bin/hubd
Restart=always
RestartSec=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# /dev/input (FLIRC) access comes from the hub user's own 'input' group
# membership (set by the installer). SupplementaryGroups is NOT usable in
# user services — the user manager cannot change group credentials.

[Install]
WantedBy=default.target
