[Unit]
Description=Bluetooth auto-accept pairing agent
After=bluetooth.service
Wants=bluetooth.service
# Re-register the agent whenever bluetoothd stops/restarts (bluetoothd can
# crash under load; without the agent, A2DP authorization is denied and
# phones connect but get no audio transport).
PartOf=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/bt-agent -c NoInputNoOutput
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
