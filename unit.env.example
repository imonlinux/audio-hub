# Audio Hub Unit Configuration
# This file defines per-unit settings for each audio hub deployment.
# Installed to /etc/audiohub/unit.env by install.sh; edit that copy.
#
# hubd, the Sendspin service, and the Bluetooth identity all read this
# file — it is the single source of truth for the unit.

# --------------------------------------------------------------------------
# Device Identity
# --------------------------------------------------------------------------
# install.sh seeds these three from the unit's hostname when it creates a
# fresh unit.env; adjust to taste (the device name is what phones show for
# Bluetooth and what Home Assistant groups the entity under).
AUDIOHUB_HOSTNAME=audio-hub
AUDIOHUB_DEVICE_ID=audio_hub
AUDIOHUB_DEVICE_NAME=Audio Hub

# --------------------------------------------------------------------------
# MQTT / Home Assistant
# --------------------------------------------------------------------------
AUDIOHUB_MQTT_HOST=192.168.0.100
AUDIOHUB_MQTT_PORT=1883
AUDIOHUB_MQTT_USERNAME=mqtt
AUDIOHUB_MQTT_PASSWORD=your_password_here
AUDIOHUB_MQTT_BASE_TOPIC=homeassistant

# --------------------------------------------------------------------------
# Audio Configuration
# --------------------------------------------------------------------------
# Pattern to match the hardware line-out sink (name or description).
# FACTORY DEFAULT for the Home Assistant "Output Device" select entity;
# a user selection persists in ~/.config/audiohub/selection.json and wins.
AUDIOHUB_LINEOUT_PATTERN=Built-in Audio Stereo

# Virtual bus names (rarely need to change)
AUDIOHUB_BUS_TV=bus.tv
AUDIOHUB_BUS_BT=bus.bt
AUDIOHUB_BUS_MUSIC=bus.music

# Duct stream names for ducking (rarely need to change)
AUDIOHUB_DUCT_TV=duct.tv
AUDIOHUB_DUCT_BT=duct.bt

# Pattern to match the TV optical capture source (TV Playing sensor).
# FACTORY DEFAULT for the Home Assistant "TV Source" select entity; a user
# selection persists in ~/.config/audiohub/selection.json, and the TV Playing
# probe follows it.
AUDIOHUB_TV_SOURCE_PATTERN=UR23
# TV Playing detection samples the UR23 level every N seconds (the UR23
# free-runs digital silence when the TV is off, so level is the only
# truthful signal-presence indicator)
AUDIOHUB_TV_PROBE_INTERVAL=10.0
AUDIOHUB_TV_PROBE_THRESHOLD=100.0

# --------------------------------------------------------------------------
# Ducking Settings
# --------------------------------------------------------------------------
AUDIOHUB_DUCKING_ENABLED=true
# Amplitude the other sources duck to while music plays (0.20 = -14 dB).
# hubd converts to PulseAudio's cubic scale, so 0.20 subjectively reads as
# roughly 35-40% loudness — tune to taste.
AUDIOHUB_DUCK_LEVEL=0.20
# Seconds of music silence before unducking (track-gap hold-off)
AUDIOHUB_DUCK_RESTORE_DELAY=2.0
# Engine poll interval in seconds
AUDIOHUB_POLL_INTERVAL=0.5
# Optional: Sendspin start/stop hook flag file. When its directory exists,
# ducking follows the flag exactly (handles pause correctly). Leave unset
# to fall back to stream-state detection (holds during pause).
# Default when unset: $XDG_RUNTIME_DIR/audiohub/music-playing
#AUDIOHUB_MUSIC_FLAG=/run/user/1000/audiohub/music-playing

# --------------------------------------------------------------------------
# IR Remote Configuration
# --------------------------------------------------------------------------
# FLIRC USB IR device path (glob pattern supported)
AUDIOHUB_IR_DEVICE=/dev/input/by-id/usb-flirc.tv_flirc_*-event-kbd

# Volume step per IR keypress (0.03 = 3%)
AUDIOHUB_IR_VOLUME_STEP=0.03

# --------------------------------------------------------------------------
# Release Updates
# --------------------------------------------------------------------------
# Units check GitHub releases weekly (Sun 04:30 + random hour) and apply
# checksum-verified updates. See README "Updating" for the full model.
#
# Hub user (installer records the resolved user here; the release updater
# targets this user's session).
#AUDIOHUB_USER=pi
#
# Master switch for the scheduled timer. Manual runs of
# 'sudo audiohub-update' are unaffected.
AUDIOHUB_AUTO_UPDATE=true

# Channel: stable = promoted releases only (default);
#          canary = includes pre-releases (soak-testing channel).
AUDIOHUB_RELEASE_CHANNEL=stable

# Pin an exact release tag — overrides the channel, and is also how you
# roll back: set it, then run 'sudo audiohub-update'.
#AUDIOHUB_RELEASE=v1.0.0

# Reboot automatically after a successful update. Default is a service
# restart only (PipeWire, hubd, sendspin) with a "reboot recommended" note.
#AUDIOHUB_UPDATE_REBOOT=false

# Sendspin client version pin (the ducking hooks are validated against it).
# Only change after re-verifying hooks on hardware.
AUDIOHUB_SENDSPIN_VERSION=7.5.0
